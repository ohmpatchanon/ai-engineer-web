---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { modules } from '../data/modules';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  readingProgress?: boolean;
  wide?: boolean;
}

const {
  title,
  description = 'Road to AI Engineer — field manual ภาษาไทยสำหรับสร้างระบบ AI ตั้งแต่พื้นฐาน Python, ML, LLM ไปจนถึง RAG, agents และ production',
  type = 'website',
  image = '/og.svg',
  noindex = false,
  readingProgress = false,
  wide = false
} = Astro.props;

const fullTitle = title === 'Road to AI Engineer' ? title : `${title} — Road to AI Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="th" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070a08" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Road to AI Engineer" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const saved = localStorage.getItem('aie:theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        } catch {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Road to AI Engineer',
      url: Astro.site,
      description,
      inLanguage: 'th'
    })} />
  </head>
  <body data-module-total={modules.length} class:list={[{ 'has-reading-progress': readingProgress }]}>
    <a class="skip-link" href="#main">ข้ามไปยังเนื้อหา</a>
    <a id="top"></a>
    {readingProgress && <div class="reading-progress" aria-hidden="true"><span data-reading-bar></span></div>}
    <Header />
    <main id="main" class:list={[{ 'main--wide': wide }]}>
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script>
      // Shared progress API ---------------------------------------------------
      const KEY = 'aie:modules';
      const getModules = (): string[] => {
        try {
          const parsed = JSON.parse(localStorage.getItem(KEY) || '[]');
          return Array.isArray(parsed) ? parsed : [];
        } catch { return []; }
      };
      const setModules = (value: string[]) => {
        const unique = [...new Set(value)];
        localStorage.setItem(KEY, JSON.stringify(unique));
        window.dispatchEvent(new CustomEvent('aie:progress', { detail: { done: unique.length } }));
      };
      (window as any).AIE = {
        getModules,
        setModules,
        toggleModule(id: string) {
          const current = getModules();
          const next = current.includes(id) ? current.filter((x) => x !== id) : [...current, id];
          setModules(next);
          return !current.includes(id);
        },
        toast(message: string) {
          const el = document.querySelector<HTMLElement>('[data-toast]');
          if (!el) return;
          el.textContent = message;
          el.classList.add('is-visible');
          window.clearTimeout((el as any)._timer);
          (el as any)._timer = window.setTimeout(() => el.classList.remove('is-visible'), 2600);
        }
      };

      // Reveal ---------------------------------------------------------------
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Reading progress -----------------------------------------------------
      const readingBar = document.querySelector<HTMLElement>('[data-reading-bar]');
      if (readingBar) {
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
          readingBar.style.width = pct + '%';
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
    </script>

    <style is:global>
      .main--wide { overflow: hidden; }
      .reading-progress {
        position: fixed;
        top: var(--header-h);
        left: 0;
        right: 0;
        height: 2px;
        z-index: 90;
        background: transparent;
        pointer-events: none;
      }
      .reading-progress span {
        display: block;
        height: 100%;
        width: 0;
        background: var(--acid);
        transition: width 0.1s linear;
      }
      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translate(-50%, 20px);
        z-index: 200;
        max-width: calc(100% - 2rem);
        padding: 0.65rem 1rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background: var(--panel-2);
        color: var(--text);
        box-shadow: var(--shadow);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s, transform 0.2s;
      }
      .toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
    </style>
  </body>
</html>

---
import { Bot, Download, RotateCcw } from '@lucide/astro';

const patterns = [
  { id: 'single', name: 'Single LLM call', desc: 'งานเดียว ไม่ต้องใช้ tool หรือหลายขั้นตอน' },
  { id: 'chain', name: 'Prompt chain', desc: 'หลายขั้นตอนตายตัว ผลของขั้นก่อนหน้าเป็น input ของขั้นถัดไป' },
  { id: 'router', name: 'Router', desc: 'จำแนกคำขอแล้วส่งไป handler หรือโมเดลที่เหมาะ' },
  { id: 'agent', name: 'Tool-using agent', desc: 'โมเดลเลือก tool และลำดับเองตามเป้าหมาย' },
  { id: 'multi', name: 'Multi-agent', desc: 'หลาย agent มีบทบาทต่างกันประสานงานกัน' }
];
const toolOptions = ['ค้นเว็บ', 'อ่านฐานข้อมูล', 'เรียก API ภายใน', 'อ่าน/เขียนไฟล์', 'ส่งอีเมล', 'สร้างปฏิทิน', 'รันโค้ด', 'ค้นเอกสาร (RAG)'];
const guardOptions = ['ยืนยันก่อนทำลายข้อมูล', 'จำกัดจำนวน steps', 'allowlist tools', 'ตรวจสิทธิ์ตามผู้ใช้', 'log ทุก tool call', 'fallback เป็นคำตอบปกติ', 'human approval', 'rate limit'];
---

<section class="lab" data-agent-lab>
  <div class="lab__bar">
    <span>AGENT BLUEPRINT</span>
    <strong data-al-status>—</strong>
  </div>
  <div class="lab__body">
    <div class="lab__grid lab__grid--side">
      <div class="lab__grid">
        <div class="lab__field">
          <label for="al-goal">เป้าหมายของ agent</label>
          <textarea id="al-goal" class="textarea" rows="3" data-al="goal" placeholder="เช่น ช่วยพนักงานตรวจสอบสถานะคำสั่งซื้อและออกใบแทนเมื่อจำเป็น"></textarea>
        </div>
        <div class="lab__field">
          <p class="lab__label">รูปแบบ workflow</p>
          <div class="pattern-list" data-al-patterns>
            {patterns.map((p, i) => (
              <label class="pattern-option">
                <input type="radio" name="al-pattern" value={p.id} checked={i === 0} />
                <span><strong>{p.name}</strong><small>{p.desc}</small></span>
              </label>
            ))}
          </div>
        </div>
        <div class="lab__field">
          <p class="lab__label">Tools ที่ต้องใช้</p>
          <div class="lab__chips" data-al-tools>
            {toolOptions.map((t) => <label><input type="checkbox" value={t} /> {t}</label>)}
          </div>
        </div>
        <div class="lab__field">
          <p class="lab__label">Guardrails</p>
          <div class="lab__chips" data-al-guards>
            {guardOptions.map((g) => <label><input type="checkbox" value={g} /> {g}</label>)}
          </div>
        </div>
        <div class="lab__grid lab__grid--2">
          <div class="lab__field">
            <label for="al-steps">Max steps</label>
            <input id="al-steps" class="input" type="number" min="1" max="12" value="6" data-al="steps" />
          </div>
          <div class="lab__field">
            <label for="al-success">เกณฑ์สำเร็จ</label>
            <input id="al-success" class="input" data-al="success" placeholder="เช่น แก้ปัญหาได้โดยไม่ต้องส่งต่อมนุษย์ >70%" />
          </div>
        </div>
      </div>

      <div>
        <div class="lab__result">
          <p class="mono tiny faint">BLUEPRINT READINESS</p>
          <p class="lab__score" data-al-score>0<small>%</small></p>
          <div class="lab__meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="ความพร้อม blueprint agent"><span data-al-meter></span></div>
          <ul class="lab__checklist" data-al-checks></ul>
          <div class="lab__warning" data-al-warn hidden><span>!</span><p data-al-warn-text></p></div>
        </div>
        <div class="lab__actions">
          <button type="button" class="btn btn--primary btn--small" data-al-export><Bot size={13} /> สร้าง blueprint</button>
          <button type="button" class="btn btn--ghost btn--small" data-al-download><Download size={13} /> ดาวน์โหลด .md</button>
          <button type="button" class="btn btn--ghost btn--small" data-al-reset><RotateCcw size={13} /> ล้าง</button>
        </div>
        <pre class="lab__output" data-al-output hidden></pre>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-agent-lab]')!;
  if (root) {
    const KEY = 'aie:lab:agent';
    const fields = [...root.querySelectorAll<HTMLTextAreaElement | HTMLInputElement>('[data-al]')];
    const patternLabel = (id: string) => root.querySelector<HTMLElement>(`input[value="${id}"]`)?.closest('label')?.querySelector('strong')?.textContent || id;
    const scoreEl = root.querySelector<HTMLElement>('[data-al-score]');
    const meter = root.querySelector<HTMLElement>('[data-al-meter]');
    const checks = root.querySelector<HTMLElement>('[data-al-checks]');
    const output = root.querySelector<HTMLElement>('[data-al-output]');
    const status = root.querySelector<HTMLElement>('[data-al-status]');
    const warn = root.querySelector<HTMLElement>('[data-al-warn]');
    const warnText = root.querySelector<HTMLElement>('[data-al-warn-text]');

    function checked(sel: string) {
      return [...root.querySelectorAll<HTMLInputElement>(`${sel} input:checked`)].map((i) => i.value);
    }
    function values() {
      const v: Record<string, string> = {};
      fields.forEach((f) => { v[f.dataset.al || ''] = f.value.trim(); });
      return v;
    }
    function update() {
      const v = values();
      const pattern = root.querySelector<HTMLInputElement>('input[name="al-pattern"]:checked')?.value || 'single';
      const tools = checked('[data-al-tools]');
      const guards = checked('[data-al-guards]');
      const steps = Number(v.steps || 0);
      const list = [
        { ok: (v.goal || '').length > 10, label: 'เป้าหมายชัดเจน' },
        { ok: tools.length > 0 || pattern === 'chain', label: 'ระบุ tools หรือขั้นตอน' },
        { ok: guards.length >= 2, label: 'มี guardrails อย่างน้อย 2 ข้อ' },
        { ok: steps > 0 && steps <= 12, label: 'กำหนด max steps สมเหตุสมผล' },
        { ok: (v.success || '').length > 5, label: 'มีเกณฑ์วัดความสำเร็จ' }
      ];
      const passed = list.filter((l) => l.ok).length;
      const pct = Math.round((passed / list.length) * 100);
      if (scoreEl) scoreEl.innerHTML = `${pct}<small>%</small>`;
      if (meter) { meter.style.width = pct + '%'; meter.closest('.lab__meter')?.setAttribute('aria-valuenow', String(pct)); }
      if (status) status.textContent = patternLabel(pattern);
      if (checks) checks.innerHTML = list.map((l) => `<li class="${l.ok ? 'is-pass' : 'is-fail'}"><span class="mark">✓</span><span>${l.label}</span></li>`).join('');

      const issues: string[] = [];
      if ((pattern === 'agent' || pattern === 'multi') && steps > 12) issues.push('Agent loop ที่ยาวเกิน 12 steps มักวนซ้ำและเปลืองต้นทุน ลองลดหรือเพิ่มการตัดสินใจที่ชัดเจน');
      if ((pattern === 'agent' || pattern === 'multi') && !guards.includes('human approval') && tools.some((t) => t.includes('เขียน') || t.includes('ส่ง'))) issues.push('มี tool ที่เขียนข้อมูลแต่ไม่มี human approval — ควรเพิ่มจุดยืนยัน');
      if (pattern === 'multi' && tools.length < 2) issues.push('Multi-agent มักไม่คุ้มถ้าไม่มี tool หลายอย่าง ลองเริ่มจาก single agent ก่อน');
      if (pattern === 'single' && tools.length > 2) issues.push('งานดูซับซ้อนกว่าจะจบใน single call — พิจารณา chain หรือ router');
      if (warn && warnText) { warn.hidden = issues.length === 0; warnText.textContent = issues.join(' · '); }

      try {
        localStorage.setItem(KEY, JSON.stringify({ fields: v, pattern, tools, guards }));
      } catch {}
      return { v, pattern, tools, guards };
    }
    function markdown() {
      const { v, pattern, tools, guards } = update();
      return `# Agent Blueprint

## เป้าหมาย
${v.goal || '_ยังไม่ระบุ_'}

## Workflow
${patternLabel(pattern)} — สูงสุด ${v.steps || '-'} steps

## Tools
${tools.map((t) => `- ${t}`).join('\n') || '- ไม่ต้องใช้ tool'}

## Guardrails
${guards.map((g) => `- ${g}`).join('\n') || '- (ยังไม่ระบุ)'}

## เกณฑ์สำเร็จ
${v.success || '_ยังไม่ระบุ_'}

## Evaluation plan
- สร้างชุดงาน 30–50 เคสพร้อมคำตอบที่ยอมรับได้
- วัด task success, จำนวน steps เฉลี่ย, tool error rate และต้นทุนต่อ task
- ทบทวน trace ของเคสที่ล้มเหลวทุกสัปดาห์

## ความเสี่ยงที่ต้องเฝ้า
- tool ถูกเรียกด้วยพารามิเตอร์ผิด
- agent วนซ้ำหรือเรียก tool ซ้ำ
- ผลลัพธ์ผิดแต่ดูมั่นใจ
- สิทธิ์การเข้าถึงข้อมูลไม่ตรงผู้ใช้

---
สร้างด้วย Road to AI Engineer · Agent Blueprint`;
    }
    root.querySelector('[data-al-export]')?.addEventListener('click', () => {
      if (!output) return;
      output.hidden = false;
      output.textContent = markdown();
      output.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    root.querySelector('[data-al-download]')?.addEventListener('click', () => {
      const blob = new Blob([markdown()], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'agent-blueprint.md';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    root.querySelector('[data-al-reset]')?.addEventListener('click', () => {
      fields.forEach((f) => { if (f.type === 'number') f.value = '6'; else f.value = ''; });
      root.querySelectorAll<HTMLInputElement>('[data-al-tools] input, [data-al-guards] input').forEach((i) => { i.checked = false; });
      const first = root.querySelector<HTMLInputElement>('input[name="al-pattern"]');
      if (first) first.checked = true;
      if (output) { output.hidden = true; output.textContent = ''; }
      try { localStorage.removeItem(KEY); } catch {}
      update();
    });
    fields.forEach((f) => f.addEventListener('input', update));
    root.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach((i) => i.addEventListener('change', update));

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved) {
        fields.forEach((f) => { if (saved.fields?.[f.dataset.al || ''] != null) f.value = saved.fields[f.dataset.al || '']; });
        if (saved.pattern) {
          const p = root.querySelector<HTMLInputElement>(`input[name="al-pattern"][value="${saved.pattern}"]`);
          if (p) p.checked = true;
        }
        root.querySelectorAll<HTMLInputElement>('[data-al-tools] input, [data-al-guards] input').forEach((i) => {
          i.checked = (saved.tools || []).includes(i.value) || (saved.guards || []).includes(i.value);
        });
      }
    } catch {}
    update();
  }
</script>

<style>
  .pattern-list { display: flex; flex-direction: column; gap: .4rem; }
  .pattern-option { display: flex; gap: .6rem; align-items: flex-start; padding: .55rem .7rem; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; transition: all .18s; }
  .pattern-option:has(input:checked) { border-color: var(--acid); background: var(--acid-soft); }
  .pattern-option input { margin-top: .25rem; accent-color: var(--acid); }
  .pattern-option span { display: flex; flex-direction: column; gap: .1rem; }
  .pattern-option strong { font-size: .8rem; font-weight: 500; }
  .pattern-option small { color: var(--faint); font-size: .68rem; line-height: 1.45; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Compass, ShieldCheck, Users, BookOpen, Code, Scale, Lock, FlaskConical } from '@lucide/astro';
import { getCollection } from 'astro:content';
import { modules } from '../data/modules';
import { guides } from '../data/guides';
import { exercises } from '../data/exercises';
import { projects } from '../data/projects';
import { glossary } from '../data/glossary';
import { resources } from '../data/resources';

const theoryEntries = await getCollection('theory');
const stats = [
  { value: String(modules.length), label: 'modules' },
  { value: String(theoryEntries.length), label: 'ทฤษฎี' },
  { value: String(guides.length), label: 'guides' },
  { value: String(exercises.length), label: 'labs' },
  { value: String(projects.length), label: 'projects' },
  { value: String(glossary.length), label: 'terms' },
  { value: String(resources.length), label: 'resources' }
];
---

<BaseLayout title="เกี่ยวกับเรา" description="แนวทาง วิธีการคัดเนื้อหา หลักการออกแบบ และนโยบายความเป็นส่วนตัวของ Road to AI Engineer">
  <header class="page-hero">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow reveal">ABOUT / FIELD MANUAL</p>
        <h1 class="reveal">สร้างแผนที่<br />ไม่ใช่<span class="text-acid">คอร์สขายของ</span></h1>
        <p class="lead reveal">Road to AI Engineer เกิดจากคำถามง่าย ๆ ว่า “ถ้าฉันเริ่มจากศูนย์วันนี้ ฉันควรเรียนอะไร เรียงลำดับอย่างไร และจะรู้ได้อย่างไรว่ากำลังไปถูกทาง?”</p>
        <div class="hero-actions reveal">
          <a href="/start" class="btn btn--primary">เริ่มตรงนี้ <ArrowRight size={14} /></a>
          <a href="#contribute" class="btn btn--ghost">ร่วมพัฒนา</a>
        </div>
      </div>
      <div class="about-stats panel reveal">
        <Compass size={20} class="text-acid" />
        <p class="mono micro">WHAT'S INSIDE</p>
        <div class="about-stats__grid">
          {stats.map((s) => <div><strong>{s.value}</strong><span>{s.label}</span></div>)}
        </div>
        <p class="mono tiny faint">2026 edition · เนื้อหาภาษาไทย</p>
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="about-block" id="why">
        <p class="eyebrow">01 / WHY</p>
        <h2>ทำไมต้องมี field manual</h2>
        <p>อินเทอร์เน็ตเต็มไปด้วยเนื้อหา AI แต่ขาดสามอย่างที่สำคัญกว่าเนื้อหา: <strong>ลำดับที่ถูกต้อง</strong>, <strong>เกณฑ์ว่าอะไรสำคัญ</strong> และ <strong>วิธีวัดว่าคุณเข้าใจจริง</strong> เว็บนี้พยายามเติมช่องว่างนั้นด้วยการรวมหลักสูตร แบบฝึกหัด โปรเจกต์ และคำแนะนำอาชีพไว้ในที่เดียว</p>
        <p>เราไม่เชื่อว่าทุกคนต้องเรียนเหมือนกัน หรือต้องจบปริญญาเพื่อทำงานสายนี้ แต่เราเชื่อว่าบางพื้นฐานข้ามไม่ได้ — และการข้ามมันมักทำให้เสียเวลามากกว่าที่ประหยัดได้</p>
      </div>

      <div class="about-block" id="method">
        <p class="eyebrow">02 / METHOD</p>
        <h2>วิธีการคัดเนื้อหา</h2>
        <div class="method-grid">
          <article><span class="mono">A</span><h3>ใช้จริงก่อนดัง</h3><p>หัวข้อที่อยู่ในหลักสูตรต้องตอบได้ว่า “ใช้ตอนไหนในงานจริง” ไม่ใช่แค่เป็นกระแสใน Twitter</p></article>
          <article><span class="mono">B</span><h3>หลักการก่อนเครื่องมือ</h3><p>เครื่องมือเปลี่ยนทุกเดือน แต่ data, evaluation, retrieval และ system thinking ยังอยู่ เราจึงให้น้ำหนักกับสิ่งเหล่านี้</p></article>
          <article><span class="mono">C</span><h3>วัดผลได้</h3><p>ทุก module มี checkpoint และ lab ที่ต้องตัดสินใจ ไม่ใช่แค่ดูวิดีโอจบแล้วกดถูก</p></article>
          <article><span class="mono">D</span><h3>บอกข้อจำกัด</h3><p>เนื้อหาที่ดีต้องบอกว่าอะไรยังไม่รู้ อะไรขึ้นกับบริบท และอะไรเป็นความเห็นไม่ใช่ข้อเท็จจริง</p></article>
        </div>
      </div>

      <div class="about-block" id="limits">
        <p class="eyebrow">03 / LIMITS</p>
        <h2>สิ่งที่เราตั้งใจไม่ทำ</h2>
        <ul class="limit-list">
          <li><ShieldCheck size={15} /><div><strong>ไม่อ้างว่างานนี้ทำให้ได้งานแน่นอน</strong><p>การเรียนรู้เพิ่มโอกาส แต่ตลาดแรงงานขึ้นกับประสบการณ์ การสื่อสาร และจังหวะเวลา</p></div></li>
          <li><ShieldCheck size={15} /><div><strong>ไม่ขายคำตอบสำเร็จรูป</strong><p>เราให้กรอบคิดและแบบฝึกหัด ไม่ได้ให้โค้ดที่ก๊อปแล้วจบ โดยไม่เข้าใจ</p></div></li>
          <li><ShieldCheck size={15} /><div><strong>ไม่ตามกระแสแบบไม่มีเหตุผล</strong><p>เครื่องมือใหม่จะถูกเพิ่มเมื่อมันแก้ปัญหาจริงและมีหลักฐานการใช้งาน ไม่ใช่เพราะมีคนพูดถึงมาก</p></div></li>
          <li><ShieldCheck size={15} /><div><strong>ไม่เก็บข้อมูลของคุณ</strong><p>ความคืบหน้าและผล lab อยู่ใน localStorage ของเบราว์เซอร์คุณเท่านั้น</p></div></li>
        </ul>
      </div>

      <div class="about-block" id="contribute">
        <p class="eyebrow">04 / CONTRIBUTE</p>
        <h2>เว็บนี้ออกแบบให้แก้ไขได้ง่าย</h2>
        <p>เนื้อหาทั้งหมดแยกออกจากหน้าจอเป็นข้อมูลที่มี type ชัดเจน หากคุณอยากเพิ่ม module, guide, lab หรือ glossary term สามารถแก้ที่ไฟล์ข้อมูลโดยไม่ต้องแตะโครงหน้า</p>
        <div class="contribute-grid">
          <div><Code size={16} /><strong>เพิ่มเนื้อหา</strong><code>src/data/modules/*.ts</code><code>src/data/guides.ts</code><code>src/data/glossary.ts</code></div>
          <div><FlaskConical size={16} /><strong>เพิ่ม lab</strong><code>src/components/labs/</code><code>src/pages/exercises/[slug].astro</code></div>
          <div><BookOpen size={16} /><strong>แก้หน้าเว็บ</strong><code>src/pages/</code><code>src/styles/global.css</code></div>
        </div>
        <p>อ่านรายละเอียด schema และขั้นตอนได้ใน <code>CONTENT_GUIDE.md</code> ที่ root ของโปรเจกต์ ทุกการเพิ่มเนื้อหาควรตรวจว่า build ผ่านและไม่มีลิงก์เสีย</p>
      </div>

      <div class="about-block" id="privacy">
        <p class="eyebrow">05 / PRIVACY</p>
        <h2>ความเป็นส่วนตัว</h2>
        <div class="privacy-card panel">
          <Lock size={18} class="text-acid" />
          <div>
            <p>เว็บนี้เป็น static site ไม่มีระบบสมาชิก ไม่มี analytics และไม่มีการส่งข้อมูลจากแบบฟอร์มหรือ lab ไปยังเซิร์ฟเวอร์</p>
            <ul>
              <li>ความคืบหน้าเก็บใน <code>localStorage</code> ภายใต้คีย์ <code>aie:*</code></li>
              <li>ล้างข้อมูลได้จากหน้า <a href="/progress">ความคืบหน้า</a></li>
              <li>ลิงก์ภายนอกจะเปิดในแท็บใหม่และมีนโยบายความเป็นส่วนตัวของตัวเอง</li>
              <li>การค้นหาใช้ไฟล์ <code>/search.json</code> ที่ generate ตอน build ไม่มีการส่งคำค้นไปที่ไหน</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="about-block" id="license">
        <p class="eyebrow">06 / LICENSE</p>
        <h2>การใช้งานเนื้อหา</h2>
        <div class="license-grid">
          <div class="license-card panel"><Scale size={17} class="text-acid" /><h3>เนื้อหา</h3><p>แนะนำให้ใช้สัญญาอนุญาต CC BY-NC-SA 4.0 — ใช้เรียนและดัดแปลงได้ โดยอ้างอิงและไม่ใช้เชิงพาณิชย์</p></div>
          <div class="license-card panel"><Code size={17} class="text-acid" /><h3>โค้ด</h3><p>แนะนำ MIT License สำหรับโค้ดโครงเว็บและ component — นำไปต่อยอดได้อย่างอิสระ</p></div>
          <div class="license-card panel"><Users size={17} class="text-acid" /><h3>แหล่งอ้างอิง</h3><p>ลิงก์ภายนอกเป็นลิขสิทธิ์ของเจ้าของเดิม เราไม่มีส่วนเกี่ยวข้องและการกล่าวถึงไม่ใช่การรับรอง</p></div>
        </div>
        <p class="license-note">หมายเหตุ: สัญญาอนุญาตข้างต้นเป็นข้อแนะนำสำหรับการนำโปรเจกต์ไปใช้ต่อ ผู้ดูแลโปรเจกต์ควรปรับให้เหมาะกับการใช้งานจริง</p>
      </div>

      <div class="about-block" id="disclaimer">
        <p class="eyebrow">07 / DISCLAIMER</p>
        <h2>ข้อจำกัดความรับผิด</h2>
        <p>เนื้อหานี้จัดทำเพื่อการเรียนรู้ ไม่ใช่คำแนะนำทางกฎหมาย การเงิน หรือการรับประกันผลลัพธ์ทางอาชีพ ข้อมูลเกี่ยวกับเครื่องมือ ราคา และ API อาจเปลี่ยนแปลงได้ ควรตรวจสอบเอกสารทางการก่อนนำไปใช้ในระบบจริง</p>
        <p>หากพบข้อผิดพลาดหรือเนื้อหาที่ล้าสมัย เรายินดีให้แก้ไข — ความถูกต้องสำคัญกว่าการดูสมบูรณ์แบบ</p>
      </div>

      <div class="about-cta panel">
        <div>
          <p class="eyebrow">READY?</p>
          <h2>เริ่มจากบทที่ใช่สำหรับคุณ</h2>
          <p>ไม่ต้องอ่านให้จบก่อนลงมือ — ลงมือแล้วกลับมาอ่านเมื่อเจอคำถาม</p>
        </div>
        <a href="/start" class="btn btn--primary">ทำแบบประเมิน <ArrowRight size={14} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .about-stats { padding: 1.2rem; border-radius: var(--radius); display: flex; flex-direction: column; gap: .55rem; align-items: flex-start; }
  .about-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; width: 100%; }
  .about-stats__grid div { padding: .5rem; border: 1px solid var(--line); border-radius: 6px; }
  .about-stats__grid strong { display: block; font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; line-height: 1.1; }
  .about-stats__grid span { font-family: var(--font-mono); font-size: .45rem; letter-spacing: .06em; color: var(--faint); }

  .about-block { padding-block: 2.2rem; border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 24px); }
  .about-block h2 { margin-top: .6rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .about-block > p:not(.eyebrow) { margin-top: 1rem; color: var(--muted); font-size: .95rem; line-height: 1.85; }
  .about-block strong { color: var(--text); font-weight: 600; }
  .about-block code { font-size: .78em; }

  .method-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .method-grid article { padding-top: .9rem; border-top: 1px solid var(--line-strong); }
  .method-grid .mono { color: var(--acid); font-size: .62rem; }
  .method-grid h3 { margin-top: .5rem; font-size: 1.02rem; }
  .method-grid p { margin-top: .35rem; color: var(--muted); font-size: .82rem; line-height: 1.7; }

  .limit-list { list-style: none; display: flex; flex-direction: column; gap: .8rem; margin-top: 1.4rem; }
  .limit-list li { display: flex; gap: .65rem; align-items: flex-start; }
  .limit-list svg { color: var(--acid); flex: none; margin-top: .2rem; }
  .limit-list strong { font-size: .88rem; font-weight: 600; }
  .limit-list p { margin-top: .2rem; color: var(--muted); font-size: .82rem; line-height: 1.65; }

  .contribute-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: 1.4rem; }
  .contribute-grid > div { display: flex; flex-direction: column; gap: .35rem; padding: .9rem; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
  .contribute-grid svg { color: var(--acid); }
  .contribute-grid strong { margin: .2rem 0; font-size: .82rem; font-weight: 500; }
  .contribute-grid code { align-self: flex-start; font-size: .6rem; }

  .privacy-card { display: flex; gap: .8rem; margin-top: 1.3rem; padding: 1.1rem; border-radius: var(--radius); }
  .privacy-card svg { flex: none; margin-top: .15rem; }
  .privacy-card p { color: var(--muted); font-size: .86rem; line-height: 1.7; }
  .privacy-card ul { margin-top: .7rem; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .35rem; }
  .privacy-card li { color: var(--muted); font-size: .8rem; line-height: 1.6; }
  .privacy-card a { color: var(--acid); }

  .license-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: 1.3rem; }
  .license-card { padding: 1rem; border-radius: var(--radius); }
  .license-card h3 { margin-top: .5rem; font-size: .95rem; }
  .license-card p { margin-top: .3rem; color: var(--muted); font-size: .76rem; line-height: 1.65; }
  .license-note { margin-top: .8rem; color: var(--faint); font-size: .7rem; }

  .about-cta { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; padding: 1.4rem; border-radius: var(--radius); }
  .about-cta h2 { margin-top: .4rem; font-size: 1.4rem; }
  .about-cta p:not(.eyebrow) { margin-top: .3rem; color: var(--muted); font-size: .8rem; }
  .about-cta .btn { margin-left: auto; flex: none; }

  @media (max-width: 760px) {
    .method-grid, .license-grid { grid-template-columns: 1fr; }
    .contribute-grid { grid-template-columns: 1fr; }
    .about-cta { flex-wrap: wrap; }
    .about-cta .btn { margin-left: 0; }
  }
</style>

<script>
  const getDone = (): string[] => {
    try { return JSON.parse(localStorage.getItem('aie:modules') || '[]'); } catch { return []; }
  };
  function syncHero() {
    const total = Number(document.querySelector('[data-hero-ring]')?.getAttribute('aria-valuemax') || 0) || Number(document.body.dataset.moduleTotal) || 28;
    const done = getDone().length;
    document.querySelectorAll<HTMLElement>('[data-hero-done]').forEach((el) => { el.textContent = String(done); });
    document.querySelectorAll<HTMLElement>('[data-hero-ring]').forEach((el) => {
      el.style.setProperty('--pct', String(total ? Math.min(100, (done / total) * 100) : 0));
      el.setAttribute('aria-valuenow', String(done));
    });
  }
  syncHero();
  window.addEventListener('aie:progress', syncHero);
  window.addEventListener('storage', (e) => { if (e.key === 'aie:modules') syncHero(); });
</script>


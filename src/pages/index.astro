---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, ArrowUpRight, Terminal, Layers, ShieldCheck, Gauge, Compass, BookOpen, MessageSquareQuote, Route, Braces } from '@lucide/astro';
import { modules, moduleBySlug } from '../data/modules';
import { phases } from '../data/phases';
import { paths } from '../data/paths';
import { guides } from '../data/guides';
import { projects } from '../data/projects';
import { exercises } from '../data/exercises';
import { interviewQuestions } from '../data/interview';
import { glossary } from '../data/glossary';
import { resources } from '../data/resources';
import { lessons, lessonSequence } from '../data/theory';
import ModuleCard from '../components/ModuleCard.astro';
import PathCard from '../components/PathCard.astro';
import GuideCard from '../components/GuideCard.astro';
import LessonCard from '../components/LessonCard.astro';

const featuredLessons = lessonSequence().slice(0, 3);

const featuredModules = ['python-for-ai', 'ml-foundations', 'transformers', 'rag-systems', 'agents-tool-use', 'ai-system-design'].map((slug) => moduleBySlug[slug]);
const featuredGuides = ['start-ai-engineering', 'rag-production-checklist', 'portfolio-that-gets-hired'].map((slug) => guides.find((g) => g.slug === slug)!).filter(Boolean);
const featuredProjects = projects.slice(0, 3);
const totalQuizQuestions = modules.reduce((sum, m) => sum + m.quiz.length, 0) + interviewQuestions.length;
---
<BaseLayout title="Road to AI Engineer" description={`Field manual ภาษาไทยสำหรับสร้างระบบ AI ตั้งแต่ Python, ML, LLM ไปจนถึง RAG, agents และ production — ${modules.length} modules, 6 phases, labs และโจทย์ portfolio จริง`}>
  <section class="hero">
    <div class="hero__orbit" aria-hidden="true">
      <svg viewBox="0 0 800 800" fill="none">
        <circle cx="400" cy="400" r="360" stroke="currentColor" stroke-opacity=".12" stroke-dasharray="2 8"/>
        <circle cx="400" cy="400" r="280" stroke="currentColor" stroke-opacity=".12"/>
        <circle cx="400" cy="400" r="180" stroke="currentColor" stroke-opacity=".09" stroke-dasharray="1 6"/>
        <circle cx="400" cy="120" r="4" fill="currentColor"/>
        <circle cx="128" cy="535" r="2.5" fill="currentColor"/>
        <circle cx="690" cy="545" r="3" fill="currentColor"/>
        <path d="M400 120C520 190 580 310 550 430" stroke="currentColor" stroke-opacity=".2" stroke-dasharray="3 7"/>
      </svg>
    </div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="hero__meta mono reveal">
          <span class="hero__edition"><span class="live-dot"></span> FIELD MANUAL · 2026 EDITION</span>
          <span class="hero__meta-sep">/</span>
          <span>26 WEEKS · 6 PHASES</span>
        </div>

        <p class="hero__kicker reveal">Road to AI Engineer</p>

        <h1 class="hero__title reveal">
          จากศูนย์<br />
          สู่ <span class="outline">AI</span> Engineer<br />
          <span class="hero__accent">ที่สร้างของจริง</span>
        </h1>

        <p class="hero__lead reveal">
          ไม่ใช่คอร์สที่สอนให้ท่อง prompt แต่เป็นสนามฝึกสำหรับสร้างระบบ AI ตั้งแต่บรรทัดแรกของ Python ไปจนถึง RAG, agents และ production ที่วัดผลได้
        </p>

        <div class="hero__actions reveal">
          <a href="/start" class="btn btn--primary">หาจุดเริ่มต้นของฉัน <ArrowRight size={15} /></a>
          <a href="/roadmap" class="btn btn--ghost"><Route size={14} /> ดู Roadmap ทั้งหมด</a>
        </div>

        <div class="hero__proof reveal">
          <div class="hero__avatars" aria-hidden="true">
            <span>01</span><span>02</span><span>03</span>
          </div>
          <p><strong>ไม่ต้องรอพร้อม</strong><br /><span class="muted">เริ่มจากบทที่ใช่สำหรับคุณ</span></p>
        </div>
      </div>

      <aside class="mission panel reveal" aria-label="แดชบอร์ดภารกิจ">
        <div class="mission__top">
          <span class="mission__status mono"><span class="live-dot"></span> LIVE / MISSION CONTROL</span>
          <span class="mono faint">v2.6</span>
        </div>

        <div class="mission__orbit">
          <div class="mission__ring" data-hero-ring role="progressbar" aria-valuemin="0" aria-valuemax={modules.length} aria-valuenow="0" aria-label="ความคืบหน้าหลักสูตร" style="--pct: 0">
            <div class="mission__ring-inner">
              <span class="mission__big mono"><span data-hero-done>0</span><small>/{modules.length}</small></span>
              <span class="mono micro">MODULES</span>
            </div>
          </div>
          <div class="mission__ring-labels mono">
            <span>BEGIN</span>
            <span>SHIP</span>
          </div>
        </div>

        <div class="mission__next">
          <p class="mono micro">NEXT MISSION · PHASE 01</p>
          <a href="/modules/python-for-ai" class="mission__next-link">
            <span class="mission__next-num">01</span>
            <span>
              <strong>Python สำหรับงาน AI</strong>
              <small>1–2 สัปดาห์ · เริ่มต้น</small>
            </span>
            <ArrowUpRight size={17} />
          </a>
        </div>

        <div class="mission__grid">
          <div><strong>06</strong><span>PHASES</span></div>
          <div><strong>{exercises.length}</strong><span>LABS</span></div>
          <div><strong>{projects.length}</strong><span>PROJECTS</span></div>
          <div><strong>{glossary.length}</strong><span>TERMS</span></div>
        </div>

        <a href="/roadmap" class="btn btn--primary btn--block mission__cta">เข้าสู่ Mission Control <ArrowRight size={14} /></a>
        <p class="mission__foot mono">LOCAL PROGRESS · ไม่ต้องสมัครสมาชิก</p>
      </aside>
    </div>

    <div class="hero__ticker" aria-hidden="true">
      <div class="ticker__track">
        {['PYTHON', 'MACHINE LEARNING', 'TRANSFORMERS', 'LLM', 'RAG', 'EVALUATION', 'AGENTS', 'MLOPS', 'SECURITY', 'PRODUCT'].map((item) => (
          <span>{item} <i>✦</i></span>
        ))}
        {['PYTHON', 'MACHINE LEARNING', 'TRANSFORMERS', 'LLM', 'RAG', 'EVALUATION', 'AGENTS', 'MLOPS', 'SECURITY', 'PRODUCT'].map((item) => (
          <span>{item} <i>✦</i></span>
        ))}
      </div>
    </div>
  </section>

  <section class="stats section--tight">
    <div class="container">
      <div class="stats__grid">
        <div class="stat reveal"><span class="stat__num">{modules.length}</span><span class="stat__label">modules<br />จากฐานถึง production</span></div>
        <div class="stat reveal"><span class="stat__num">{phases.length}</span><span class="stat__label">phases<br />เรียงตามลำดับที่ควรรู้</span></div>
        <div class="stat reveal"><span class="stat__num">{exercises.length}</span><span class="stat__label">interactive labs<br />ฝึกคิด ไม่ใช่ดูเฉลย</span></div>
        <div class="stat reveal"><span class="stat__num">{totalQuizQuestions}<sup>+</sup></span><span class="stat__label">questions<br />quiz และสัมภาษณ์</span></div>
        <div class="stat reveal"><span class="stat__num">{resources.length}</span><span class="stat__label">curated resources<br />คัดแล้ว ไม่ยัด affiliate</span></div>
      </div>
    </div>
  </section>

  <section class="section section--line manifesto">
    <div class="container">
      <div class="manifesto__grid">
        <div class="manifesto__label reveal">
          <span class="mono">00 / WHY THIS EXISTS</span>
          <span class="manifesto__line"></span>
        </div>
        <div class="manifesto__body">
          <h2 class="reveal">ตลาดเต็มไปด้วย “เรียน AI”<br />แต่ขาดแผนที่ที่<span class="text-acid">พาไปถึงงานจริง</span></h2>
          <p class="lead reveal">คลิปมีเป็นพัน คอร์สมีเป็นร้อย แต่สิ่งที่หายากคือลำดับการเรียนรู้ที่ถูกต้อง การวัดผลที่ซื่อสัตย์ และคนที่บอกคุณตรง ๆ ว่าอะไรคือพื้นฐาน อะไรคือของจอแจ</p>
          <div class="principles">
            <article class="principle reveal">
              <span class="principle__num mono">A</span>
              <h3>ลึกพอที่จะทำงาน</h3>
              <p>ไม่หยุดที่ “เรียก API เป็น” แต่เข้าใจ data, retrieval, evaluation, latency, cost และ failure modes ของระบบจริง</p>
            </article>
            <article class="principle reveal">
              <span class="principle__num mono">B</span>
              <h3>กว้างพอที่จะเลือกทาง</h3>
              <p>มีทั้งสาย LLM, ML, Product และ MLOps ให้เลือกตามพื้นเดิมและเป้าหมาย ไม่ใช่บังคับทุกคนให้เดินเส้นเดียว</p>
            </article>
            <article class="principle reveal">
              <span class="principle__num mono">C</span>
              <h3>จริงพอที่จะวัดผล</h3>
              <p>ทุก module มี lab, checkpoint และคำถามที่ผิดได้ พร้อมโจทย์ portfolio ที่มีเกณฑ์ประเมิน ไม่ใช่แค่ tutorial สวย ๆ</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section paths-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">CHOOSE YOUR TRAJECTORY</p>
          <h2 class="reveal">สี่เส้นทาง<br />ที่พาไปอาชีพต่างกัน</h2>
        </div>
        <p class="section-head__aside reveal">ทุกเส้นทางใช้ฐานร่วมกัน แต่ให้น้ำหนักต่างกัน เลือกจากสิ่งที่คุณอยากสร้าง ไม่ใช่แค่ตำแหน่งที่ตลาดพูดถึง</p>
      </div>
      <div class="grid grid-4 paths-grid">
        {paths.map((path) => <div class="reveal"><PathCard path={path} /></div>)}
      </div>
    </div>
  </section>

  <section class="section section--line curriculum">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">THE CURRICULUM</p>
          <h2 class="reveal">6 phase.<br />เรียงตามลำดับที่สมองรับได้</h2>
        </div>
        <p class="section-head__aside reveal">ไม่มีทางลัดที่ข้ามพื้นฐานได้จริง แต่มีเส้นทางที่ลดการอ้อมได้ นี่คือลำดับที่เราใช้จริงในงาน</p>
      </div>

      <div class="phase-map reveal">
        {phases.map((phase) => (
          <a href={`/roadmap#${phase.id}`} class:list={['phase-step', `phase-step--${phase.color}`]}>
            <span class="phase-step__num mono">{phase.number}</span>
            <span class="phase-step__main">
              <span class="phase-step__title">{phase.title}</span>
              <span class="phase-step__en mono">{phase.en}</span>
            </span>
            <span class="phase-step__weeks mono">{phase.weeks.replace('สัปดาห์ ', 'W')}</span>
            <ArrowUpRight size={15} class="phase-step__arrow" />
          </a>
        ))}
      </div>

      <div class="featured-head">
        <p class="mono small muted">ตัวอย่าง 6 modules ที่เป็นแกนของหลักสูตร</p>
        <a href="/modules" class="link-arrow">ดูทั้ง {modules.length} modules <ArrowRight size={13} /></a>
      </div>
      <div class="grid grid-3 module-grid">
        {featuredModules.map((module) => <div class="reveal"><ModuleCard module={module} /></div>)}
      </div>
    </div>
  </section>

  <section class="section theory-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">UNDERSTAND FIRST</p>
          <h2 class="reveal">รู้สึกว่าอ่านแล้ว<br /><span class="text-acid">"เข้าใจ"</span></h2>
        </div>
        <p class="section-head__aside reveal">ชั้นความรู้แบบตำรา {lessons.length} บท — อธิบายหลักการละเอียด มีลำดับและ prerequisite ชัดเจน ตั้งแต่คณิตที่ AI ใช้ ไปจนถึง Transformer, RAG, agents และ production</p>
      </div>

      <div class="grid grid-3 lesson-grid-home">
        {featuredLessons.map((lesson) => <div class="reveal"><LessonCard lesson={lesson} /></div>)}
      </div>
      <div class="theory-cta reveal">
        <span class="mono tiny faint">เรียงลำดับ T.01 → T.{String(lessons.length).padStart(2, '0')} พร้อม prereq ทุกบท</span>
        <a href="/theory" class="btn btn--ghost btn--small">เปิดห้องทฤษฎีทั้งหมด <ArrowRight size={13} /></a>
      </div>
    </div>
  </section>

  <section class="section lab-callout">
    <div class="container">
      <div class="lab-callout__inner panel reveal">
        <div class="lab-callout__copy">
          <p class="eyebrow">INTERACTIVE LAB / 01</p>
          <h2>prompt ของคุณ<br />สื่อสารรู้เรื่องแค่ไหน?</h2>
          <p>ลองวาง prompt ที่ใช้อยู่ แล้วให้ Lab ตรวจ 8 องค์ประกอบสำคัญ ตั้งแต่ role, context, constraints ไปจนถึงเกณฑ์สำเร็จที่วัดได้</p>
          <div class="lab-callout__actions">
            <a href="/exercises/prompt-lab" class="btn btn--primary">ลอง Prompt Lab <ArrowRight size={14} /></a>
            <span class="mono tiny muted">ใช้เวลา 3 นาที · บันทึกในเครื่องคุณ</span>
          </div>
        </div>
        <div class="prompt-preview" aria-hidden="true">
          <div class="prompt-preview__bar mono"><span>prompt_audit.md</span><span class="text-acid">● LIVE</span></div>
          <pre><span class="code-dim"># Task</span>
สกัดข้อมูลใบเสร็จเป็น JSON

<span class="code-dim"># Constraints</span>
- ห้ามเดาค่าที่ไม่ปรากฏ
- วันที่ต้องเป็น ISO 8601

<span class="code-dim"># Output</span>
&#123;
  "vendor": string,
  "total": number,
  "date": string
&#125;</pre>
          <div class="score-bars">
            <div><span>Context</span><i style="--w: 92%"></i><b>92</b></div>
            <div><span>Format</span><i style="--w: 96%"></i><b>96</b></div>
            <div><span>Criteria</span><i style="--w: 74%"></i><b>74</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--line projects-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">PROOF OF WORK</p>
          <h2 class="reveal">portfolio ที่ดี<br />ไม่ใช่ gallery</h2>
        </div>
        <p class="section-head__aside reveal">มันคือชุดข้อโต้แย้งว่าคุณแก้ปัญหาประเภทนี้ได้ เริ่มจากโจทย์ที่มีผู้ใช้จริง ข้อจำกัดจริง และตัวเลขที่วัดได้</p>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project, i) => (
          <a href={`/projects/${project.slug}`} class="project-row panel panel--hover reveal">
            <span class="project-row__num mono">0{i + 1}</span>
            <div class="project-row__main">
              <div class="project-row__meta mono"><span>{project.category}</span><span>·</span><span>{project.time}</span></div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <div class="project-row__skills">
              {project.skills.slice(0, 3).map((skill) => <span class="tag">{skill}</span>)}
            </div>
            <ArrowUpRight size={18} class="project-row__arrow" />
          </a>
        ))}
      </div>
      <div class="projects-foot reveal">
        <a href="/projects" class="link-arrow">ดูโจทย์ทั้ง {projects.length} โปรเจกต์พร้อม rubric <ArrowRight size={13} /></a>
      </div>
    </div>
  </section>

  <section class="section roles-section">
    <div class="container">
      <div class="roles-grid">
        <div class="roles-copy">
          <p class="eyebrow reveal">THE REAL WORK</p>
          <h2 class="reveal">งานนี้ไม่ใช่<br />“เขียน prompt เก่ง”</h2>
          <p class="lead reveal">AI Engineer คือวิศวกรที่ทำให้ความสามารถของโมเดลกลายเป็นระบบที่คนใช้ได้จริง — และนั่นหมายถึงงานที่ไม่ได้ glamorous เสมอไป</p>
          <div class="roles-list">
            <div class="role-item reveal"><span class="mono">01</span><div><h3>Data & Evaluation</h3><p>ทำความสะอาดข้อมูล สร้าง eval set วัด quality และหา failure mode ก่อนใครจะเห็นปัญหา</p></div></div>
            <div class="role-item reveal"><span class="mono">02</span><div><h3>Systems Engineering</h3><p>ออกแบบ API, retrieval, caching, fallback, observability และทำให้ต้นทุนกับ latency อยู่ในกรอบ</p></div></div>
            <div class="role-item reveal"><span class="mono">03</span><div><h3>Product Judgment</h3><p>ตัดสินใจว่าควรใช้ AI หรือไม่ วัดคุณค่าที่ผู้ใช้ได้รับ และออกแบบให้ความไม่แน่นอนไม่ทำร้ายใคร</p></div></div>
          </div>
        </div>
        <div class="reality-card panel reveal">
          <div class="reality-card__top mono"><span>FIELD NOTE</span><span class="text-acid">READ BEFORE STARTING</span></div>
          <blockquote>“โมเดลที่ดีที่สุด ไม่ใช่โมเดลที่คะแนน benchmark สูงที่สุด แต่คือโมเดลที่ทำให้งานของผู้ใช้สำเร็จได้ด้วยต้นทุนที่องค์กรรับไหว”</blockquote>
          <div class="reality-card__foot">
            <span class="mono tiny">THE OPERATING PRINCIPLE</span>
            <span class="reality-card__stamp">RTAE / 001</span>
          </div>
          <div class="reality-card__grid mono">
            <div><span class="faint">TOOLS</span><strong>เปลี่ยนได้</strong></div>
            <div><span class="faint">FOUNDATIONS</span><strong>อยู่ยาว</strong></div>
            <div><span class="faint">EVIDENCE</span><strong>ต้องวัด</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--line guides-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow reveal">FIELD GUIDES</p>
          <h2 class="reveal">คำแนะนำที่ไม่ทำให้<br />คุณเสียเวลาเปล่า</h2>
        </div>
        <a href="/guides" class="link-arrow reveal">guides ทั้งหมด <ArrowRight size={13} /></a>
      </div>
      <div class="grid grid-3 guides-grid">
        {featuredGuides.map((guide) => <div class="reveal"><GuideCard guide={guide} /></div>)}
      </div>

      <div class="knowledge-bento">
        <a href="/interview" class="bento bento--large panel panel--hover reveal">
          <MessageSquareQuote size={22} class="bento__icon" />
          <div><span class="mono micro">INTERVIEW BANK</span><h3>{interviewQuestions.length} คำถาม<br />พร้อมแนวทางตอบ</h3></div>
          <p>ครอบคลุม Python, ML, LLM, RAG, agents, system design และ behavioral</p>
          <ArrowUpRight size={18} class="bento__arrow" />
        </a>
        <a href="/glossary" class="bento panel panel--hover reveal">
          <BookOpen size={20} class="bento__icon" />
          <div><span class="mono micro">GLOSSARY</span><h3>{glossary.length} คำ</h3></div>
          <p>ภาษาไทย–อังกฤษ พร้อมคำอธิบายที่ใช้จริง</p>
          <ArrowUpRight size={18} class="bento__arrow" />
        </a>
        <a href="/resources" class="bento panel panel--hover reveal">
          <Layers size={20} class="bento__icon" />
          <div><span class="mono micro">RESOURCES</span><h3>{resources.length} แหล่ง</h3></div>
          <p>คอร์ส หนังสือ เอกสาร และเครื่องมือที่คัดแล้ว</p>
          <ArrowUpRight size={18} class="bento__arrow" />
        </a>
        <a href="/cheatsheets" class="bento panel panel--hover reveal">
          <Braces size={20} class="bento__icon" />
          <div><span class="mono micro">CHEATSHEETS</span><h3>Quick ref</h3></div>
          <p>สรุป metric, RAG, prompt และ system design</p>
          <ArrowUpRight size={18} class="bento__arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section os-section">
    <div class="container">
      <div class="os-head">
        <p class="eyebrow reveal">THE LEARNING OS</p>

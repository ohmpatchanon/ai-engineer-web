---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowRight, BookOpenText, Compass, Layers } from '@lucide/astro';
import { lessons } from '../../data/theory';
import { lessonSequence } from '../../data/theory';
import { lessonMinutes, lessonWordCount } from '../../data/theory';
import { phases } from '../../data/phases';
import LessonCard from '../../components/LessonCard.astro';

const sequence = lessonSequence();
const totalMinutes = lessons.reduce((sum, l) => sum + lessonMinutes(l), 0);
const totalWords = lessons.reduce((sum, l) => sum + lessonWordCount(l), 0);
const byPhase = phases.map((phase) => ({
  phase,
  items: lessons.filter((l) => l.phase === phase.id)
})).filter((g) => g.items.length > 0);
---
<BaseLayout title="ทฤษฎี — ความรู้ให้เข้าใจ" description={`ชั้นความรู้เชิงลึก ${lessons.length} บท ครอบคลุมคณิตศาสตร์, ML, โครงข่ายประสาท, Transformer, RAG, agents, production และ responsible AI — เรียงลำดับและมี prerequisite ชัดเจน (≈${totalMinutes} นาที)`}>
  <header class="theory-hero">
    <div class="container theory-hero__grid">
      <div>
        <p class="eyebrow reveal">THEORY / KNOWLEDGE BASE / {lessons.length} LESSONS</p>
        <h1 class="reveal">อ่านให้<span class="text-acid">เข้าใจ</span><br />ก่อนลงมือทำ</h1>
        <p class="lead reveal">ชั้นความรู้แบบตำรา — อธิบายหลักการให้ละเอียด ก่อนจะไปเจอแบบฝึกหัดและโปรเจกต์ ส่วนนี้เรียงลำดับตามจำนวนบท ระบุ prereq กำกับไว้ทุกบท จึงอ่านเป็นเส้นทางได้</p>
        <div class="hero-actions reveal">
          <a href={`/theory/${sequence[0].slug}`} class="btn btn--primary">เริ่มบทแรก {sequence[0].number} <ArrowRight size={14} /></a>
          <a href="/roadmap" class="btn btn--ghost">ดู roadmap</a>
        </div>
      </div>
      <div class="theory-stats panel reveal">
        <BookOpenText size={20} class="text-acid" />
        <p class="mono micro">WHAT YOU'LL READ</p>
        <div class="theory-stats__grid">
          <div><strong>{lessons.length}</strong><span>บท</span></div>
          <div><strong>~{totalMinutes}</strong><span>นาที</span></div>
          <div><strong>{phases.filter((p) => lessons.some((l) => l.phase === p.id)).length}</strong><span>phase</span></div>
        </div>
        <p>เนื้อหาความรู้ทั้งหมด {Math.round(totalWords / 100) / 10}K+ คำ ทุกบทระบุ prereq และโยงถึง module ที่ต้องลงมือทำ</p>
      </div>
    </div>
  </header>

  <section class="section section--tight">
    <div class="container">
      <div class="theory-guide panel">
        <Compass size={17} class="text-acid" />
        <div>
          <p class="mono micro">วิธีอ่านให้ได้ผล</p>
          <p>อ่านตามลำดับบท (T.01 → …) เพราะบทใหม่สมมติว่าคุณจำ prereq ได้ หากข้ามให้เปิด prereq ที่กำกับไว้ก่อน จากนั้นปิดหน้าทฤษฎีแล้วไปทำ <a href="/exercises" class="inline-link">lab ของบทนั้น</a> — ทฤษฎีจะติดก็ต่อเมื่อโดนบังคับใช้</p>
        </div>
      </div>

      <section class="reading-order" id="reading-order">
        <div class="section-head">
          <div><p class="eyebrow reveal">READING ORDER</p><h2 class="reveal">ลำดับการอ่านที่แนะนำ</h2></div>
          <p class="section-head__aside reveal">เรียงจากรากฐานก่อน — ทุกบทมี prereq ตรวจสอบโดย build ว่าไม่มีบทที่อ้างถึงบทที่ยังไม่ต่าง</p>
        </div>
        <div class="order-track reveal" aria-label="ลำดับบทเรียน">
          {sequence.map((lesson, i) => (
            <a href={`/theory/${lesson.slug}`} class="order-node">
              <span class="order-node__dot"></span>
              <span class="order-node__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="order-node__title">{lesson.title}</span>
              <span class="mono order-node__t">~{lessonMinutes(lesson)}m</span>
            </a>
          ))}
        </div>
        <a href="#lesson-1" class="skip-order">ข้ามไปที่บทเรียน <ArrowRight size={12} /></a>
      </section>

      <section class="theory-list">
        {byPhase.map((group) => (
          <div class="theory-phase" id={group.phase.id}>
            <div class="theory-phase__head reveal">
              <span class:list={['phase-chip', `phase-chip--${group.phase.color}`]}>{group.phase.number}</span>
              <div>
                <p class="mono micro">{group.phase.en} · {group.phase.weeks}</p>
                <h2>{group.phase.title}</h2>
                <p>{group.phase.description}</p>
              </div>
              <span class="mono theory-phase__count">{group.items.length} บท</span>
            </div>
            <div class="lesson-grid">
              {group.items.map((lesson) => <LessonCard lesson={lesson} />)}
            </div>
          </div>
        ))}
      </section>

      <div class="theory-mini-map panel" id="lesson-1">
        <div class="theory-mini-map__head">
          <Layers size={16} class="text-acid" />
          <p class="mono micro">MINI-MAP</p>
          <span class="mono tiny faint">{lessons.length} บท · ~{totalMinutes} นาที</span>
        </div>
        <div class="mini-subjects">
          <div><strong>รากฐาน</strong><span>T.01 คณิตศาสตร์</span></div>
          <div><strong>ML</strong><span>T.02–T.05 โมเดล/evals/classical/features</span></div>
          <div><strong>Deep</strong><span>T.06–T.08 NN · CNN · NLP</span></div>
          <div><strong>LLM</strong><span>T.09–T.15 Transformer–LLM–RAG–FT–agents</span></div>
          <div><strong>Prod</strong><span>T.16–T.17 production · observability</span></div>
          <div><strong>Impact</strong><span>T.18–T.19 responsible · product</span></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .theory-hero { padding-top: calc(var(--header-h) + 3rem); padding-bottom: 3.5rem; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  .theory-hero::before { content: ''; position: absolute; width: 60vw; height: 60vw; max-width: 720px; right: -25%; top: -40%; border-radius: 50%; background: radial-gradient(circle, rgba(211, 250, 124, 0.08), transparent 65%); pointer-events: none; }
  .theory-hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.6fr); gap: clamp(2rem, 5vw, 5rem); position: relative; }
  .theory-hero h1 { font-size: clamp(2.6rem, 6vw, 5.2rem); line-height: 1.02; }
  .hero-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .theory-stats { padding: 1.2rem; border-radius: var(--radius); display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .theory-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; width: 100%; }
  .theory-stats__grid div { padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px; }
  .theory-stats__grid strong { display: block; font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; line-height: 1.1; }
  .theory-stats__grid span { font-family: var(--font-mono); font-size: 0.46rem; letter-spacing: 0.07em; color: var(--faint); }
  .theory-stats > p:not(.micro) { color: var(--muted); font-size: 0.76rem; line-height: 1.65; }

  .theory-guide { display: flex; align-items: flex-start; gap: 0.8rem; padding: 1.1rem; border-radius: var(--radius); margin-bottom: 2.5rem; }
  .theory-guide svg { flex: none; margin-top: 0.15rem; }
  .theory-guide p:not(.micro) { margin-top: 0.3rem; color: var(--muted); font-size: 0.84rem; line-height: 1.7; }
  .inline-link { color: var(--acid); text-decoration: underline; text-underline-offset: 3px; }

  .reading-order { padding-block: 1rem 2.5rem; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.4rem; }
  .section-head h2 { margin-top: 0.5rem; font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .section-head__aside { max-width: 46ch; color: var(--muted); font-size: 0.82rem; line-height: 1.7; }
  .order-track { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.6rem; }
  .order-node { position: relative; display: flex; flex-direction: column; gap: 0.3rem; padding: 0.75rem; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; min-height: 110px; background: linear-gradient(to bottom, var(--panel), var(--bg-soft)); }
  .order-node:hover { border-color: var(--acid); }
  .order-node__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--acid); }
  .order-node__num { color: var(--faint); font-size: 0.54rem; }
  .order-node__title { font-size: 0.78rem; line-height: 1.45; color: var(--text); }
  .order-node__t { margin-top: auto; color: var(--faint); font-size: 0.52rem; }
  .skip-order { display: none; }
  @media (max-width: 980px) { .order-track { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 620px) { .order-track { grid-template-columns: repeat(2, 1fr); } }

  .theory-phase { padding-block: 2rem; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 24px); }
  .theory-phase__head { display: grid; grid-template-columns: 46px 1fr auto; gap: 1rem; align-items: start; margin-bottom: 1.2rem; }
  .phase-chip { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: var(--panel-2); font-family: var(--font-mono); font-size: 0.68rem; color: var(--acid); }
  .phase-chip--amber { color: var(--amber); } .phase-chip--sky { color: var(--sky); } .phase-chip--violet { color: var(--violet); }
  .phase-chip--coral { color: var(--coral); } .phase-chip--sand { color: var(--sand); }
  .theory-phase__head h2 { margin-top: 0.35rem; font-size: 1.5rem; }
  .theory-phase__head p:not(.micro) { margin-top: 0.4rem; color: var(--muted); font-size: 0.82rem; line-height: 1.65; max-width: 72ch; }
  .theory-phase__count { color: var(--faint); font-size: 0.58rem; padding-top: 0.2rem; }

  .lesson-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
  @media (max-width: 820px) { .lesson-grid { grid-template-columns: 1fr; } }

  .theory-mini-map { padding: 1.2rem; border-radius: var(--radius); margin-top: 2.5rem; }
  .theory-mini-map__head { display: flex; align-items: center; gap: 0.5rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--line); }
  .theory-mini-map__head .tiny { margin-left: auto; }
  .mini-subjects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 1rem; }
  .mini-subjects div { padding: 0.7rem 0.8rem; border: 1px solid var(--line); border-radius: 7px; background: var(--bg-soft); }
  .mini-subjects strong { display: block; font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.06em; color: var(--acid); }
  .mini-subjects span { display: block; margin-top: 0.25rem; color: var(--muted); font-size: 0.72rem; line-height: 1.5; }
  @media (max-width: 720px) { .mini-subjects { grid-template-columns: 1fr 1fr; } }

  @media (max-width: 760px) {
    .theory-hero__grid { grid-template-columns: 1fr; }
    .theory-stats { max-width: 460px; }
    .section-head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>
